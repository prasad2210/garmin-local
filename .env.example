# garmin-local configuration
# Copy this to .env and fill in values. Never commit .env.

# Garmin Connect credentials (used only for first-run login)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Paths
GARMIN_TOKEN_STORE=~/.garminconnect
GARMIN_DB_PATH=data/garmin.db
GARMIN_RAW_DIR=data/raw
GARMIN_FIT_DIR=data/fit
GARMIN_LOG_PATH=data/sync.log

# Sync settings
SYNC_CADENCE_DAYS=7
SYNC_BACKFILL_DAYS=90
SYNC_RATE_LIMIT_SLEEP_MIN=1.0
SYNC_RATE_LIMIT_SLEEP_MAX=2.0
SYNC_BACKOFF_MAX_RETRIES=3

# MCP server
MCP_TRANSPORT=stdio
